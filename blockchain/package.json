{
  "name": "@kyobo/blockchain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "node node_modules/hardhat/internal/cli/cli.js compile",
    "test": "node node_modules/hardhat/internal/cli/cli.js test",
    "node": "node node_modules/hardhat/internal/cli/cli.js node --hostname 0.0.0.0",
    "node:local": "node node_modules/hardhat/internal/cli/cli.js node",
    "deploy:local": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy/deploy-rewards.ts --network localhost",
    "deploy:sepolia": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy/deploy-rewards.ts --network sepolia",
    "deploy:securities:local": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy/deploy-securities.ts --network localhost"
  },
  "devDependencies": {
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0"
  }
}
