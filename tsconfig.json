{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "Node16",
    "moduleResolution": "Node16",
    "lib":              ["ES2022"],
    "strict":           true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess":   true,
    "noImplicitReturns":          true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck":     true,
    "resolveJsonModule": true,
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "outDir":           "./dist",
    "baseUrl":          ".",
    "paths": {
      "@kyobo/chain-adapters":      ["dmz/packages/chain-adapters/src"],
      "@kyobo/event-engine":        ["dmz/packages/event-engine/src"],
      "@kyobo/event-engine/*":      ["dmz/packages/event-engine/src/*"],
      "@kyobo/vasp":                ["dmz/packages/vasp/src"],
      "@kyobo/compliance":          ["dmz/packages/compliance/src"],
      "@kyobo/core-banking":        ["dmz/packages/core-banking/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
