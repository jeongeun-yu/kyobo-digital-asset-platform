{
  "name": "kyobo-digital-asset-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Kyobo Digital Asset Platform",
  "workspaces": [
    "blockchain",
    "dmz/apps/*",
    "dmz/packages/*",
    "tools/event-listener"
  ],
  "scripts": {
    "build":               "npm run build --workspaces",
    "build:all":           "npm run build --workspaces --if-present && cd blockchain && npx hardhat compile",
    "test":                "npm run test --workspaces --if-present",
    "test:exercises":      "npm run test:exercises --workspace=dmz/packages/event-engine",
    "typecheck":           "npm run typecheck --workspaces --if-present",
    "node:local":          "cd blockchain && npx hardhat node",
    "deploy:local":        "cd blockchain && npx hardhat run scripts/deploy/deploy-rewards.ts --network localhost",
    "deploy:securities":   "cd blockchain && npx hardhat run scripts/deploy/deploy-securities.ts --network localhost",
    "isms:check":          "cd dmz/apps/issuer-service && npx ts-node src/scripts/isms-check.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
