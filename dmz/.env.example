# =============================================================================
# 교보생명 내부망 실습 환경 설정
# 복사 후 .env로 이름 변경 → 실제 값 입력
# .env는 git에 커밋하지 않는다 (.gitignore에 포함)
# =============================================================================

# ── EVM (Sepolia 테스트넷) ────────────────────────────────────────────────────
# RPC URL: Infura/Alchemy 사용 시 교체. 미입력 시 공개 RPC 자동 사용.
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 서명용 개인키: MetaMask → 계정 내보내기 → 0x로 시작하는 64자리 hex
# ⚠ 테스트넷 전용 계정만 사용할 것. 실제 자산이 있는 계정 절대 금지.
EVM_SIGNER_KEY=

# EVM 체인 ID (Sepolia=11155111, Mainnet=1, Polygon=137)
EVM_CHAIN_ID=11155111

# ── XRPL ────────────────────────────────────────────────────────────────────
XRPL_WS_URL=wss://xrplcluster.com
XRPL_SEED=

# ── Circle ──────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api-sandbox.circle.com

# ── Bitcoin (UTXO) ──────────────────────────────────────────────────────────
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_NETWORK=testnet
