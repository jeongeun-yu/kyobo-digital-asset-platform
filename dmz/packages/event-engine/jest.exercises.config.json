{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testMatch": ["**/src/exercises/__tests__/**/*.test.ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "tsconfig": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": false
      }
    }]
  }
}
