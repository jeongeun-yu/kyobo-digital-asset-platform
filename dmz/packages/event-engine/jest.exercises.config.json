{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "forceExit": true,
  "roots": ["<rootDir>/../../../course/exercises/__tests__"],
  "testMatch": ["**/*.test.ts"],
  "moduleNameMapper": {
    "^@kyobo/event-engine$": "<rootDir>/src/index.ts"
  },
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "tsconfig": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": false
      }
    }]
  }
}
