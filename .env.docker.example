# ============================================================
# 교보 디지털 자산 플랫폼 — Docker 실습 환경 전용 환경변수
# env/docker 브랜치에서만 사용
# 사용법: cp .env.docker.example .env
# ============================================================

# ── DB / Redis (docker-compose 기본값과 일치) ────────────────
DATABASE_URL=postgresql://kyobo:kyobo_dev_pw@localhost:5432/kyobo_da
REDIS_URL=redis://:kyobo_redis_pw@localhost:6379
POSTGRES_PASSWORD=kyobo_dev_pw
REDIS_PASSWORD=kyobo_redis_pw

# ── EVM (Hardhat 로컬 노드) ──────────────────────────────────
EVM_RPC_URL=http://localhost:8545
EVM_CHAIN_ID=31337
EVM_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# ↑ Hardhat 기본 테스트 계정 #0 (로컬 전용 — 절대 메인넷 사용 금지)

MOCK_CONTRACT_ADDR=
# ↑ npm run deploy:local 실행 후 출력되는 주소 입력

# ── Webhook ──────────────────────────────────────────────────
WEBHOOK_SECRET=dev_secret_local_only
WEBHOOK_PORT=3000

# ── 체인 (로컬 Hardhat) ─────────────────────────────────────
RPC_URL=http://localhost:8545
CHAIN_ID=31337
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── 컨트랙트 주소 (deploy:local 후 입력) ─────────────────────
NFT_CONTRACT_ADDR=
NFT_ISSUER_ADDR=
ORACLE_ADDR=
ORACLE_SIGNER_ADDRESS=

# ── 외부 연동 (Docker 환경에서는 Mock 사용) ──────────────────
VASP_API_URL=http://localhost:3001/mock/vasp
VASP_API_KEY=mock_key
CORE_BANKING_URL=http://localhost:3001/mock/cb
CORE_BANKING_CLIENT_ID=mock_client
CORE_BANKING_SECRET=mock_secret
BASE_METADATA_URI=http://localhost:3000/nft

# ── XRPL / Circle / Bitcoin (실습 시 강사 안내) ─────────────
XRPL_WS_URL=wss://xrplcluster.com
XRPL_SEED=
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api-sandbox.circle.com
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_NETWORK=testnet
