{
  "name": "@kyobo/event-engine",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".":            "./src/index.ts",
    "./listener":   "./src/listener/index.ts",
    "./webhook":    "./src/webhook/index.ts",
    "./handlers":   "./src/handlers/index.ts",
    "./interfaces": "./src/interfaces/IEventHandler.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.json --runInBand",
    "test:exercises": "jest --config jest.exercises.config.json",
    "test:exercises:answer": "jest --config jest.exercises.answer.config.json",
    "test:all": "jest --config jest.config.json && jest --config jest.exercises.config.json",
    "test:watch": "jest --config jest.config.json --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.ts"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "node",
          "esModuleInterop": true,
          "strict": false
        }
      }]
    }
  }
}
