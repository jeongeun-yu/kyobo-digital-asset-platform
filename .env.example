# ============================================================
# 교보 디지털 자산 플랫폼 — 환경 변수 템플릿
# 이 파일을 복사해 .env를 만들고 값을 채운다.
# .env는 절대 git에 커밋하지 않는다 (.gitignore 확인)
# ============================================================

# ── Anvil 로컬 ────────────────────────────────────────────────────────────────
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337
# Hardhat 기본 계정 #0 (deployer / issuer-service operator — 로컬 전용)
ANVIL_DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Hardhat 기본 계정 #1 (MockVASP OPERATOR_ROLE)
ANVIL_OPERATOR_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Anvil 컨트랙트 주소 (deploy:local 실행 후 교체)
ANVIL_NFT_CONTRACT_ADDR=
ANVIL_NFT_ISSUER_ADDR=
ANVIL_MOCK_VASP_ADDR=
ANVIL_ORACLE_ADDR=

# ── Sepolia 테스트넷 ──────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
SEPOLIA_CHAIN_ID=11155111
DEPLOYER_PRIVATE_KEY=                        # 테스트넷 배포 전용 계정 (KMS에서 주입)
SEPOLIA_OPERATOR_KEY=                        # MockVASP OPERATOR_ROLE 키
SEPOLIA_OPERATOR_ADDR=                       # 위 키의 주소
ETHERSCAN_API_KEY=                           # 컨트랙트 검증용

# Sepolia 컨트랙트 주소 (deploy --network sepolia 실행 후 교체)
SEPOLIA_NFT_CONTRACT_ADDR=
SEPOLIA_NFT_ISSUER_ADDR=
SEPOLIA_MOCK_VASP_ADDR=
SEPOLIA_ORACLE_ADDR=

# ── issuer-service 런타임 (로컬 기본값) ───────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
OPERATOR_PRIVATE_KEY=                        # KMS에서 주입 — 여기 입력 금지
NFT_CONTRACT_ADDR=
NFT_ISSUER_ADDR=

# ── VASP 파트너 API ────────────────────────────────────────────────────────────
VASP_API_URL=https://api.vasp-stub.local
VASP_API_KEY=                                # KMS에서 주입

# ── Core Banking ───────────────────────────────────────────────────────────────
CORE_BANKING_URL=http://localhost:9090
CORE_BANKING_SECRET=                         # KMS에서 주입

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=<32자 이상 랜덤 문자열>
WEBHOOK_PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kyobo:<PASSWORD>@localhost:5432/kyobo_da
POSTGRES_PASSWORD=                           # 로컬 개발용

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=<host>:<port>
REDIS_PASSWORD=                              # 로컬 개발용

# ── 강의 실습 ─────────────────────────────────────────────────────────────────
EVM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
EVM_CHAIN_ID=11155111
EVM_SIGNER_KEY=                              # 강의용 Sepolia 계정 개인키
EVM_SIGNER_ADDRESS=                          # 위 키의 주소
MOCK_CONTRACT_ADDR=                          # MockERC1155 주소 (deploy-mock-sepolia.ts 배포 후 설정)

# ── XRPL ─────────────────────────────────────────────────────────────────────
XRPL_WS_URL=wss://xrplcluster.com
XRPL_SEED=                                   # XRPL 계정 시크릿 시드 (KMS에서 주입)

# ── Circle CCTP ──────────────────────────────────────────────────────────────
CIRCLE_API_KEY=                              # Circle API 키 (KMS에서 주입)
CIRCLE_BASE_URL=https://api-sandbox.circle.com
