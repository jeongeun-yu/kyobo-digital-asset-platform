# ============================================================
# 교보 디지털 자산 플랫폼 — 환경 변수 템플릿
# 실제 값은 절대 git에 커밋하지 않는다 (.gitignore 확인)
# 프로덕션 값은 KMS 또는 교보 시크릿 관리 시스템에서 주입
# ============================================================

# ── 체인 연결 ──────────────────────────────────────────────
RPC_URL=http://10.0.1.10:8545        # 내부망 RPC 노드 (프로덕션)
CHAIN_ID=137                          # Polygon Mainnet (프로덕션)
OPERATOR_PRIVATE_KEY=                 # KMS에서 주입 — 여기 입력 금지

# ── 컨트랙트 주소 (배포 후 기록) ───────────────────────────
NFT_CONTRACT_ADDR=
NFT_ISSUER_ADDR=
ORACLE_ADDR=
ORACLE_SIGNER_ADDRESS=               # 오라클 서명 계정 주소

# ── VASP 파트너 API ────────────────────────────────────────
VASP_API_URL=https://api.vasp-partner.com
VASP_API_KEY=                         # KMS에서 주입

# ── Core Banking 연동 ──────────────────────────────────────
CORE_BANKING_URL=https://api.kyobo-cb.internal
CORE_BANKING_CLIENT_ID=
CORE_BANKING_SECRET=                  # KMS에서 주입

# ── Webhook 보안 ───────────────────────────────────────────
WEBHOOK_SECRET=                       # HMAC 시크릿 (KMS에서 주입)
WEBHOOK_PORT=3000

# ── 메타데이터 ─────────────────────────────────────────────
BASE_METADATA_URI=https://meta.kyobo-da.internal/nft

# ── DB / Redis ────────────────────────────────────────────
DATABASE_URL=postgresql://kyobo:PASSWORD@localhost:5432/kyobo_da
REDIS_URL=redis://:PASSWORD@localhost:6379
POSTGRES_PASSWORD=                    # 로컬 개발용만
REDIS_PASSWORD=                       # 로컬 개발용만

# ── 배포 (테스트넷) ────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=                 # 테스트넷 배포 전용 계정
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHERSCAN_API_KEY=

# ── 강의 실습 (chain-adapters / event-listener) ───────────
EVM_RPC_URL=https://rpc.sepolia.org      # Sepolia 공개 RPC (강의용)
EVM_CHAIN_ID=11155111                    # Sepolia chain ID
EVM_SIGNER_KEY=e0183ffff4ffb416f04a81f53e359373d78be5626bf103da50560cbad5d70e55
EVM_SIGNER_ADDRESS=0x91ffcbB6f6dC947C01d402eA5703b9D27e8aA363
MOCK_CONTRACT_ADDR=                      # MockERC1155 주소 (deploy-mock-sepolia.ts 배포 후 설정)

# ── XRPL ─────────────────────────────────────────────────────
XRPL_WS_URL=wss://xrplcluster.com        # XRPL WebSocket (강의용 공개 노드)
XRPL_SEED=                               # XRPL 계정 시크릿 시드 (KMS에서 주입)

# ── Circle CCTP ───────────────────────────────────────────────
CIRCLE_API_KEY=                          # Circle API 키 (KMS에서 주입)
CIRCLE_BASE_URL=https://api-sandbox.circle.com  # 샌드박스 (프로덕션: https://api.circle.com)

# ── Bitcoin / UTXO ────────────────────────────────────────────
BITCOIN_RPC_URL=http://localhost:8332    # Bitcoin Core RPC
BITCOIN_NETWORK=testnet                  # mainnet | testnet
